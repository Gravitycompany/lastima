print("=== ELIMINANDO TODO ===")

local Players = game:GetService("Players")
local Workspace = game:GetService("Workspace")
local Lighting = game:GetService("Lighting")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local jugadorLocal = Players.LocalPlayer
local personaje = jugadorLocal.Character or jugadorLocal.CharacterAdded:Wait()

-- Función para verificar si es parte del personaje del jugador
local function esDelJugador(objeto)
    if personaje and objeto:IsDescendantOf(personaje) then
        return true
    end
    if objeto == personaje then
        return true
    end
    return false
end

-- ELIMINAR TODO EN WORKSPACE
print("Eliminando TODO del Workspace...")
local contador = 0
for _, objeto in pairs(Workspace:GetChildren()) do
    if objeto ~= Workspace.Terrain and objeto ~= Workspace.Camera and not esDelJugador(objeto) then
        pcall(function()
            objeto:Destroy()
            contador = contador + 1
        end)
    end
end
print("✓ Eliminados " .. contador .. " objetos del Workspace")

-- ELIMINAR TERRAIN COMPLETAMENTE
print("Eliminando Terreno...")
pcall(function()
    Workspace.Terrain:Clear()
    print("✓ Terreno eliminado")
end)

-- ELIMINAR TODO EN LIGHTING
print("Eliminando efectos de Lighting...")
contador = 0
for _, objeto in pairs(Lighting:GetChildren()) do
    pcall(function()
        objeto:Destroy()
        contador = contador + 1
    end)
end
print("✓ Eliminados " .. contador .. " efectos de Lighting")

-- ELIMINAR SONIDOS EN TODO EL JUEGO
print("Eliminando TODOS los sonidos...")
contador = 0
for _, servicio in pairs({Workspace, ReplicatedStorage, game:GetService("SoundService")}) do
    for _, objeto in pairs(servicio:GetDescendants()) do
        if objeto:IsA("Sound") then
            pcall(function()
                objeto:Destroy()
                contador = contador + 1
            end)
        end
    end
end
print("✓ Eliminados " .. contador .. " sonidos")

