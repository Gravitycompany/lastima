-- BLOQUEAR NUEVOS OBJETOS
print("Bloqueando creación de nuevos objetos...")
Workspace.DescendantAdded:Connect(function(objeto)
    if not esDelJugador(objeto) then
        wait(0.01)
        pcall(function()
            -- Eliminar efectos y decoraciones instantáneamente
            if objeto:IsA("ParticleEmitter") or objeto:IsA("Smoke") or 
               objeto:IsA("Fire") or objeto:IsA("Sparkles") or 
               objeto:IsA("Trail") or objeto:IsA("Beam") or
               objeto:IsA("Sound") or objeto:IsA("PointLight") or
               objeto:IsA("SpotLight") or objeto:IsA("SurfaceLight") or
               objeto:IsA("Decal") or objeto:IsA("Texture") then
                objeto:Destroy()
            end
        end)
    end
end)

